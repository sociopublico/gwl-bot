# URL del stream. Para YouTube Live: https://www.youtube.com/watch?v=...
# También acepta URLs directas de audio/HLS/RTMP (FFmpeg las abre sin yt-dlp).
STREAM_URL=

# Página UN Web TV del meeting (opcional). Solo calibra el reloj del vivo; no va en el mail.
# No uses el canal 24/7: no tiene DVR.
# WEBTV_URL=https://webtv.un.org/en/asset/k10/k10h1p03zp

# Palabras o frases a detectar, separadas por coma. Matching por palabra, case-insensitive.
KEYWORDS=women,gender,refugees

# Seek en VOD (segundos desde el inicio del video). En live se ignora.
# Ejemplo Lula ~47:25: STREAM_START_SECONDS=2830
STREAM_START_SECONDS=0

# Si es true, el proceso sale cuando termina un VOD en vez de rebobinar en loop.
EXIT_ON_EOF=true

# Modelo de faster-whisper: tiny, base, small, medium, large-v3, o variantes .en
# En CPU, "base" es el mejor punto de partida. "small" mejora accuracy y sube CPU/RAM.
WHISPER_MODEL=base

# Idioma ISO-639-1. Vacío = autodetección (más lento; Whisper analiza cada chunk).
LANGUAGE=en

# Segundos de audio por ventana de transcripción. 20 s da más contexto en la alerta.
CHUNK_SECONDS=20

# Segundos reusados del chunk anterior para no cortar nombres/frases en el borde.
# Con ventanas de 20–30 s, 4 s cubre una presentación diplomática cortada.
CHUNK_OVERLAP_SECONDS=4

# Palabras de contexto a cada lado de la keyword en el log y el email.
CONTEXT_WORDS=20

# Segundos de espera antes de reintentar si el stream se cae.
RECONNECT_DELAY=10

# Modelo de inferencia. Este POC está pensado para CPU.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true

# Threads de CPU para CTranslate2 / OpenMP (bot YouTube).
CPU_THREADS=4
# Pipeline UNGA en Docker: no uses CPU_THREADS=4 ni WHISPER_MODEL=base si el VPS
# tiene poca RAM. El compose del pipeline usa estos (default tiny / 1 thread):
# PIPELINE_WHISPER_MODEL=tiny
# PIPELINE_CPU_THREADS=1

# Heartbeat periódico aunque no haya keywords.
HEARTBEAT_SECONDS=60

# Watchdog: mail + HEALTHCHECK si no hay chunk transcrito en N segundos.
# 0 = apagado. Compose no reinicia un contenedor unhealthy; mirá `docker compose ps`.
WATCHDOG_SECONDS=180
WATCHDOG_EMAIL_COOLDOWN=600

# Margen extra (segundos) al esperar cada chunk de audio.
AUDIO_READ_TIMEOUT=30

# Opcional: cookies de YouTube en formato Netscape (Compose monta ./youtube.cookies.txt).
# Necesario si yt-dlp dice "Sign in to confirm you're not a bot".
COOKIES_FILE=/cookies/youtube.txt

LOG_LEVEL=INFO
# Directorio local de logs (full.log + highlights.log). Compose monta ./logs → /app/logs.
LOG_DIR=logs

# Tracker de orador por presentaciones de protocolo ("His Excellency...").
SPEAKER_TRACKING=true
# Alias exactos (substring): lula:Luiz Inacio Lula da Silva
SPEAKER_ALIASES=
# Lista canónica de oradores (nombre, o "nombre | país | cargo").
# Whisper puede decir "Louis Narsier"; el bot lo mapea al nombre de acá.
# También matchea "president of Brasil" / "prime minister of Canada".
# Separar entradas con ; o saltos de línea. Para muchos, usar un archivo.
# SPEAKER_ROSTER=Luiz Inacio Lula da Silva | Brazil | President;Emmanuel Macron | France | President
SPEAKER_ROSTER_FILE=/speakers.txt
# SPEAKER_ROSTER_THRESHOLD=0.62

# LLM opcional (OpenAI-compatible) cuando el regex no extrae un nombre claro.
# Sin API key el tracker sigue con regex nada más.
# SPEAKER_LLM_API_KEY=
# SPEAKER_LLM_BASE_URL=https://api.openai.com/v1
# SPEAKER_LLM_MODEL=gpt-4o-mini
# SPEAKER_LLM_TIMEOUT=8

# Alertas por email (opcional). Si falta SMTP_HOST, SMTP_FROM o ALERT_EMAIL_TO, solo se loguea.
# Mailgun SMTP (DigitalOcean bloquea 25/465/587; Mailgun también escucha 2525 + STARTTLS).
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=2525
# SMTP_USER=postmaster@mails.tudominio.com
# SMTP_PASSWORD=<SMTP password del dominio en Mailgun, no la API key>
# SMTP_FROM=bot@mails.tudominio.com
# SMTP_STARTTLS=true
# EU: SMTP_HOST=smtp.eu.mailgun.org
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Segunda API key (opcional): horas pares usan A, horas impares usan B.
# SMTP_PASSWORD_B=
# SMTP_USER_B=
# SMTP_FROM_B=
ALERT_EMAIL_TO=
SMTP_STARTTLS=true
# SMTP_SSL=true
ALERT_COOLDOWN_SECONDS=120
# Segundos de transcripción que el mail incluye antes y después de la keyword.
# El mail espera el "después" (default 30s) antes de salir.
ALERT_TEXT_BEFORE_SECONDS=75
ALERT_TEXT_AFTER_SECONDS=30
SMTP_TIMEOUT=15

# --- Pipeline UNGA → Google Sheets ---
# El ID sale de https://docs.google.com/spreadsheets/d/{ESTE_ID}/edit
# El link /d/e/2PACX-.../pub?output=csv SOLO sirve para leer CSV, no para escribir.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_METADATA_TAB=Metadata
GOOGLE_SHEETS_ANALYSIS_TAB=Analysis
GOOGLE_SHEETS_INDICATORS_TAB=Indicators
GOOGLE_SHEETS_EMERGING_TAB=Emerging_Priorities
GOOGLE_SHEETS_COUNTRY_TAB=country_list
# JSON de la service account (fuera de git). Compartir el Sheet con el email de la SA como Editor.
GOOGLE_APPLICATION_CREDENTIALS=/home/agus/.config/gwl-bot/sheets-sa.json
# Opcional: CSV publicado de la pestaña country_list (lectura sin auth; puede ir minutos atrasado)
# GOOGLE_SHEETS_COUNTRY_CSV=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=GID&single=true&output=csv
# GITHUB_REPO=org/repo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=
# GIT_AUTHOR_NAME=gwl-pipeline
# GIT_AUTHOR_EMAIL=gwl-bot@users.noreply.github.com
# GITHUB_TRANSCRIPT_STYLE=blob
# Path en el HOST al JSON de la service account (Docker del pipeline).
# No pongas un path de tu laptop: en el server usá secrets/google-sa.json
# PIPELINE_SA_FILE=./secrets/google-sa.json
# KALTURA_PARTNER_ID=2503451
# Traducción de pdf_other → inglés: deep-translator (Google, sin API key).

# --- Pipeline UNGA → Claude (coding codebook + analyze legacy) ---
# Metodología: claude-prompt.md en la raíz del repo.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_CACHE_TTL=1h
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANALYZE_ALLOW_STUB=0
